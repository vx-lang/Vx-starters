// Tests for gpu-router: every kernel in ops.vx against the same formula as plain host code.
// Returns the number of failed checks, and prints "ok" when there are none. It also prints three
// entries of each result, which check.py computes again in Python.
//
//   ./build.sh

import core::convert;
import core::num;
import ops;


fn abs64(v : f64) -> f64 {
  if v < 0.0 {
    return 0.0 - v;
  }
  return v;
}

fn verdict(name : *const i8, worst : f64, tol : f64, e0 : f32, e1 : f32, e2 : f32) -> i32 {
  print!(name);
  print!(": ");
  print!(f64::from(e0));
  print!(" ");
  print!(f64::from(e1));
  print!(" ");
  print!(f64::from(e2));
  print!("\n");
  if worst > tol {
    print!("  FAIL: differs from the host code by ");
    print!(worst);
    print!("\n");
    return 1;
  }
  return 0;
}

const TOKENS : i32 = 50;
const EXPERTS : i32 = 64;

// Router inputs. `ties` logits take 9 values on a quarter-step grid, so many experts of a row
// have the same logit and only the bias (a multiple of 1/64) or the id tells them apart.
fn logit(t : i32, e : i32, ties : i32) -> f32 {
  // ties = 2: every expert of a group (4 of them) has one logit, and groups share three levels.
  if ties == 2 {
    return (((t + e / 4) % 3) as f32) / 2.0;
  }
  if ties != 0 {
    return (((t * 3 + e * 7) % 9) as f32) / 4.0 - 1.0;
  }
  return ((((t * EXPERTS + e) * 37) % 101) as f32) / 8.0 - 6.0;
}

fn bias_of(e : i32, ties : i32) -> f32 {
  if ties == 2 {
    return 0.0;
  }
  if ties != 0 {
    return ((e % 4) as f32) / 64.0;
  }
  return 0.0 - ((e % 5) as f32) / 128.0;
}

fn sigmoid_host(v : f32) -> f32 {
  return 1.0 / (1.0 + (0.0 - v).exp());
}

// The host router, by ranks instead of repeated scans: a group is chosen if fewer than
// `topk_group` groups beat it, an expert is picked if fewer than k eligible experts beat it, and
// its slot is that count. "Beats" is a higher score, or an equal one with a lower id.
fn host_route(t : i32, k : i32, groups : i32, topk_group : i32, ties : i32, scale : f32, ids : &mut Tensor<i32, [8]>, w : &mut Tensor<f32, [8]>) -> void {
  let size = EXPERTS / groups;
  let mut score = Tensor<f32, [64]>::new();
  for e in 0..EXPERTS { score[e] = sigmoid_host(logit(t, e, ties)) + bias_of(e, ties); }
  let mut gscore = Tensor<f32, [16]>::new();
  for g in 0..groups {
    let mut m1 : f32 = -1000000000.0;
    let mut m2 : f32 = -1000000000.0;
    for e in g * size..(g + 1) * size {
      if score[e] > m1 { m2 = m1; m1 = score[e]; } else if score[e] > m2 { m2 = score[e]; }
    }
    gscore[g] = m1 + m2;
    if size == 1 { gscore[g] = m1; }
  }
  let mut total : f32 = 0.0;
  for e in 0..EXPERTS {
    let g = e / size;
    let mut gbeat = 0;
    for h in 0..groups {
      if gscore[h] > gscore[g] || (gscore[h] == gscore[g] && h < g) { gbeat += 1; }
    }
    if gbeat < topk_group {
      let mut beat = 0;
      for f in 0..EXPERTS {
        let hg = f / size;
        let mut hbeat = 0;
        for h in 0..groups {
          if gscore[h] > gscore[hg] || (gscore[h] == gscore[hg] && h < hg) { hbeat += 1; }
        }
        if hbeat < topk_group {
          if score[f] > score[e] || (score[f] == score[e] && f < e) { beat += 1; }
        }
      }
      if beat < k {
        ids[beat] = e;
        w[beat] = sigmoid_host(logit(t, e, ties));
        total += w[beat];
      }
    }
  }
  for s in 0..k { w[s] = w[s] / (total + 0.00000000000000000001) * scale; }
}

// Runs one configuration on the device and compares every token with the host router. Returns
// the number of mismatches, and prints token 0 and token 49's picks and token 17's weights.
fn run(name : *const i8, k : i32, groups : i32, topk_group : i32, ties : i32, scale : f32) -> i32 {
  let mut logits_h = Tensor<f32, [50, 64]>::new();
  let mut bias_h = Tensor<f32, [64]>::new();
  for t in 0..TOKENS {
    for e in 0..EXPERTS { logits_h[t][e] = logit(t, e, ties); }
  }
  for e in 0..EXPERTS { bias_h[e] = bias_of(e, ties); }
  let logits = transfer(logits_h, Memory::HBM);
  let bias = transfer(bias_h, Memory::HBM);
  let mut ids = transfer(Tensor<i32, [50, 8]>::new(), Memory::HBM);
  let mut w = transfer(Tensor<f32, [50, 8]>::new(), Memory::HBM);
  let mut gsel = transfer(Tensor<i32, [50, 16]>::new(), Memory::HBM);
  router_topk(&mut ids, &mut w, &mut gsel, &logits, &bias, TOKENS, EXPERTS, k, groups, topk_group, scale);
  let ids_o = transfer(ids, Memory::CPU_DRAM);
  let w_o = transfer(w, Memory::CPU_DRAM);
  let mut wrong = 0;
  let mut worst : f64 = 0.0;
  let mut hi = Tensor<i32, [8]>::new();
  let mut hw = Tensor<f32, [8]>::new();
  for t in 0..TOKENS {
    host_route(t, k, groups, topk_group, ties, scale, &mut hi, &mut hw);
    for s in 0..k {
      if ids_o[t][s] != hi[s] { wrong += 1; }
      let d = abs64(f64::from(w_o[t][s] - hw[s]));
      if d > worst { worst = d; }
    }
  }
  print!(name);
  print!("_ids: ");
  for s in 0..k { print!(ids_o[0][s]); print!(" "); }
  print!(ids_o[49][0]);
  print!(" ");
  print!(ids_o[49][k - 1]);
  print!("\n");
  print!(name);
  let mut failed = verdict("_weights", worst, 0.00001, w_o[17][0], w_o[17][1], w_o[17][k - 1]);
  if wrong > 0 {
    print!("  FAIL: ");
    print!(wrong);
    print!(" picks differ from the host router\n");
    failed += 1;
  }
  return failed;
}

fn main() -> i32 {
  let mut failed = 0;
  // 8 groups of 8, the 4 best groups, 8 experts: GLM-like, with many ties.
  failed += run("grouped", 8, 8, 4, 1, 2.5);
  // One group: a plain top-6 over distinct scores.
  failed += run("plain", 6, 1, 1, 0, 1.0);
  // Whole groups tie, and the cut after 3 groups falls inside a tie: the lower group ids win.
  failed += run("tied", 8, 16, 3, 2, 1.0);
  if failed == 0 {
    print!("ok\n");
  }
  return failed;
}
