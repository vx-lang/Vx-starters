// Tests for interval. Prints some intervals for build.sh to compare, then "ok", and returns
// the number of failed checks.
//
//   ./build.sh

import bigint::int;
import rational::rat;
import interval::ival;

fn q(s : *const i8) -> Rational {
  return Rational::parse(s).unwrap();
}

fn check(name : *const i8, ok : bool) -> i32 {
  if ok {
    return 0;
  }
  print!("FAIL: ");
  print!(name);
  print!("\n");
  return 1;
}

fn same(a : &Interval, b : &Interval) -> bool {
  return a.lo.compare(&b.lo) == 0 && a.hi.compare(&b.hi) == 0;
}

fn check_same(name : *const i8, got : &Interval, want : &Interval) -> i32 {
  if same(got, want) {
    return 0;
  }
  print!("FAIL: ");
  print!(name);
  print!(": got ");
  got.print();
  print!(", want ");
  want.print();
  print!("\n");
  return 1;
}

// Whether x is a multiple of 2^-k.
fn on_grid(x : &Rational, k : i64) -> bool {
  return x.times(&Rational::from_int(BigInt::from_i64(1).shl(k))).is_int();
}

// xorshift64, as in ../bigint/test.vx.
struct Rng {
  s : u64,
}

impl Rng {
  fn next(self : &mut Rng) -> u64 {
    let mut x = self.s;
    x = x ^ (x << 13);
    x = x ^ (x >> 7);
    x = x ^ (x << 17);
    self.s = x;
    return x;
  }

  fn frac(self : &mut Rng) -> Rational {
    let n = (self.next() % 2001u64) as i64 - 1000;
    let d = (self.next() % 97u64) as i64 + 1;
    return Rational::frac(n, d);
  }

  fn interval(self : &mut Rng) -> Interval {
    let a = self.frac();
    let b = self.frac();
    return Interval::new(a.min(&b), a.max(&b));
  }

  // A point of x: one of its ends, or a point between them.
  fn point_in(self : &mut Rng, x : &Interval) -> Rational {
    let t = Rational::frac((self.next() % 9u64) as i64, 8);
    return x.lo.plus(&t.times(&x.width()));
  }
}

// The defining property: an operation on points of X and Y lands in the operation on X and Y.
fn check_enclosure(x : &Interval, y : &Interval, a : &Rational, b : &Rational, k : i64) -> i32 {
  let mut failed = 0;
  failed += check("x + y in X + Y", x.plus(y).contains(&a.plus(b)));
  failed += check("x - y in X - Y", x.minus(y).contains(&a.minus(b)));
  failed += check("x * y in X * Y", x.times(y).contains(&a.times(b)));
  if !y.contains_zero() {
    failed += check("x / y in X / Y", x.over(y).contains(&a.over(b)));
  }
  failed += check("-x in -X", x.negated().contains(&a.negated()));
  failed += check("|x| in |X|", x.abs().contains(&a.abs()));
  failed += check("x^2 in X^2", x.pow(2).contains(&a.pow(2)));
  failed += check("x^3 in X^3", x.pow(3).contains(&a.pow(3)));
  failed += check("X^2 inside X * X", x.times(x).contains_interval(&x.pow(2)));
  failed += check("x in round_out(X)", x.round_out(k).contains(a));
  let r = x.round_out(k);
  failed += check("round_out ends on the grid", on_grid(&r.lo, k) && on_grid(&r.hi, k));
  failed += check("x in hull(X, Y)", x.hull(y).contains(a));
  if x.is_nonneg() {
    // s is in sqrt(X) when s >= 0 and s^2 = x; check the squares of the ends instead.
    let s = x.sqrt(k);
    failed += check("sqrt: lo^2 <= x", s.lo.sign() >= 0 && s.lo.pow(2).compare(a) <= 0);
    failed += check("sqrt: hi^2 >= x", s.hi.pow(2).compare(a) >= 0);
    failed += check("sqrt ends on the grid", on_grid(&s.lo, k) && on_grid(&s.hi, k));
  }
  return failed;
}

fn main() -> i32 {
  let mut failed = 0;
  let x = Interval::fracs(-1, 1, 2, 1);
  failed += check_same("[-1, 2]^2", &x.pow(2), &Interval::fracs(0, 1, 4, 1));
  failed += check_same("[-1, 2] * [-1, 2]", &x.times(&x), &Interval::fracs(-2, 1, 4, 1));
  failed += check_same("[-1, 2]^3", &x.pow(3), &Interval::fracs(-1, 1, 8, 1));
  failed += check_same("|[-3, 2]|", &Interval::fracs(-3, 1, 2, 1).abs(), &Interval::fracs(0, 1, 3, 1));
  failed += check_same("[1, 2] / [-4, -2]", &Interval::fracs(1, 1, 2, 1).over(&Interval::fracs(-4, 1, -2, 1)),
                       &Interval::fracs(-1, 1, -1, 4));
  failed += check_same("[1, 2] - [1, 2]", &Interval::fracs(1, 1, 2, 1).minus(&Interval::fracs(1, 1, 2, 1)),
                       &Interval::fracs(-1, 1, 1, 1));
  failed += check_same("sqrt([4, 9])", &Interval::fracs(4, 1, 9, 1).sqrt(10), &Interval::fracs(2, 1, 3, 1));
  // floor(sqrt(2) * 2^20) = 1482910, from Python's math.isqrt(2 << 40).
  failed += check_same("sqrt(2), 20 bits", &Interval::from_i64(2).sqrt(20),
                       &Interval::fracs(1482910, 1048576, 1482911, 1048576));
  failed += check_same("round_out([1/3, 2/3], 3)", &Interval::fracs(1, 3, 2, 3).round_out(3),
                       &Interval::fracs(1, 4, 3, 4));
  failed += check("[0, 1] and [2, 3] do not meet",
                  Interval::fracs(0, 1, 1, 1).intersect(&Interval::fracs(2, 1, 3, 1)).is_none());
  failed += check("[0, 2] and [1, 3] meet in [1, 2]",
                  same(&Interval::fracs(0, 1, 2, 1).intersect(&Interval::fracs(1, 1, 3, 1)).unwrap(),
                       &Interval::fracs(1, 1, 2, 1)));
  failed += check("[1/3, 1/2] is positive", Interval::fracs(1, 3, 1, 2).is_pos());
  failed += check("[0, 1/2] is not positive", !Interval::fracs(0, 1, 1, 2).is_pos());
  failed += check("[0, 1/2] is nonnegative", Interval::fracs(0, 1, 1, 2).is_nonneg());
  failed += check("[-1, 0] is below [1/2, 1]", Interval::fracs(-1, 1, 0, 1).below(&Interval::fracs(1, 2, 1, 1)));
  failed += check("[-1, 1] is not below [1, 2]", !Interval::fracs(-1, 1, 1, 1).below(&Interval::fracs(1, 1, 2, 1)));

  let mut rng = Rng { s: 1181783497276652981u64 };
  for i in 0..1500 {
    let x = rng.interval();
    let y = rng.interval();
    let a = rng.point_in(&x);
    let b = rng.point_in(&y);
    failed += check_enclosure(&x, &y, &a, &b, (rng.next() % 40u64) as i64);
  }

  // A small proof: for every t in [0, 1/2], t^2 - t + 1/3 > 0. Split [0, 1/2] into 8 pieces
  // and check each piece. One piece is not enough, because the enclosure of t^2 - t is loose.
  let whole = Interval::fracs(0, 1, 1, 2);
  let f = whole.pow(2).minus(&whole).plus(&Interval::fracs(1, 3, 1, 3));
  failed += check("one piece is too coarse", !f.is_pos());
  let mut all = true;
  for i in 0..8 {
    let t = Interval::fracs(i as i64, 16, (i + 1) as i64, 16);
    let piece = t.pow(2).minus(&t).plus(&Interval::fracs(1, 3, 1, 3));
    if !piece.is_pos() {
      all = false;
    }
  }
  failed += check("eight pieces prove it", all);

  // build.sh compares these with values from Python.
  Interval::from_i64(2).sqrt(20).print();
  print!("\n");
  f.print();
  print!("\n");

  if failed == 0 {
    print!("ok\n");
  }
  return failed;
}
