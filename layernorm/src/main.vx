// layernorm: computing the statistics behind LayerNorm and RMSNorm without losing them, and
// LayerNorm's backward formula checked against `grad`.
//
// LayerNorm needs a row's mean and variance. The one-pass formula var = E[x^2] - E[x]^2 is the
// textbook one, and in f32 it cancels catastrophically when the mean is large next to the
// spread: two nearly equal numbers are subtracted and the difference is mostly rounding error.
// It can even come out negative. Two passes (mean first, then the squared deviations) or
// Welford's running update do not have that problem.
//
// The checks:
//   1. Rows of 4096 f32 values around 1000 with spread 0.1: one-pass f32 variance is far off
//      (or negative), two-pass and Welford in f32 are within 1% of the f64 answer.
//   2. Chan's merge: Welford statistics of two halves, merged, equal those of the whole row.
//      This is how a row split across devices (sequence or tensor parallelism) is normalized.
//   3. RMSNorm, x / sqrt(mean(x^2) + eps), equals LayerNorm without its affine part on a row
//      whose mean is zero.
//   4. LayerNorm's gradient, written out: dx = (g - mean(g) - y mean(g y)) / sigma, for an
//      upstream gradient g and the output y, against `grad` on each input of a 6-value row.
//
// It returns the number of failed checks, and prints "ok" when there are none.

import core::convert;
import core::num;
import std::vec;

struct Rng {
  s : u64,
}

impl Rng {
  fn next(self : &mut Rng) -> u64 {
    let mut x = self.s;
    x = x ^ (x << 13);
    x = x ^ (x >> 7);
    x = x ^ (x << 17);
    self.s = x;
    return x;
  }

  fn unit(self : &mut Rng) -> f64 {
    return ((self.next() >> 11) as f64) / 9007199254740992.0f64;
  }
}

// --- 1. Variance in f32 ----------------------------------------------------------------------

fn one_pass(x : &Vec<f32>) -> f32 {
  let mut s : f32 = 0.0;
  let mut s2 : f32 = 0.0;
  for i in 0..x.len() {
    s = s + x.get(i);
    s2 = s2 + x.get(i) * x.get(i);
  }
  let n = x.len() as f32;
  let m = s / n;
  return s2 / n - m * m;
}

fn two_pass(x : &Vec<f32>) -> f32 {
  let mut s : f32 = 0.0;
  for i in 0..x.len() {
    s = s + x.get(i);
  }
  let n = x.len() as f32;
  let m = s / n;
  let mut d2 : f32 = 0.0;
  for i in 0..x.len() {
    let d = x.get(i) - m;
    d2 = d2 + d * d;
  }
  return d2 / n;
}

// Welford's running statistics: count, mean, and the sum of squared deviations m2.
struct Stats {
  n : f32,
  mean : f32,
  m2 : f32,
}

impl Copy for Stats {}

fn welford(x : &Vec<f32>, from : i32, to : i32) -> Stats {
  let one : f32 = 1.0;
  let mut st = Stats { n: 0.0f32, mean: 0.0f32, m2: 0.0f32 };
  for i in from..to {
    let v = x.get(i);
    st.n = st.n + one;
    let d = v - st.mean;
    st.mean = st.mean + d / st.n;
    st.m2 = st.m2 + d * (v - st.mean);
  }
  return st;
}

// Chan et al.: the statistics of two parts combined.
fn merge(a : Stats, b : Stats) -> Stats {
  let n = a.n + b.n;
  let d = b.mean - a.mean;
  return Stats {
    n: n,
    mean: a.mean + d * b.n / n,
    m2: a.m2 + b.m2 + d * d * a.n * b.n / n,
  };
}

fn exact_variance(x : &Vec<f32>) -> f64 {
  let mut s : f64 = 0.0;
  for i in 0..x.len() {
    s = s + f64::from(x.get(i));
  }
  let m = s / f64::from(x.len());
  let mut d2 : f64 = 0.0;
  for i in 0..x.len() {
    let d = f64::from(x.get(i)) - m;
    d2 = d2 + d * d;
  }
  return d2 / f64::from(x.len());
}

fn rel(got : f32, want : f64) -> f64 {
  return (f64::from(got) - want).abs() / want;
}

// --- 3 and 4. LayerNorm and RMSNorm on a row of 6 f64 values ---------------------------------

struct Row {
  x0 : f64,
  x1 : f64,
  x2 : f64,
  x3 : f64,
  x4 : f64,
  x5 : f64,
}

impl Copy for Row {}

fn at(r : Row, k : i32) -> f64 {
  if k == 0 {
    return r.x0;
  }
  if k == 1 {
    return r.x1;
  }
  if k == 2 {
    return r.x2;
  }
  if k == 3 {
    return r.x3;
  }
  if k == 4 {
    return r.x4;
  }
  return r.x5;
}

fn with(r : Row, k : i32, v : f64) -> Row {
  let mut m = r;
  if k == 0 {
    m.x0 = v;
  } else if k == 1 {
    m.x1 = v;
  } else if k == 2 {
    m.x2 = v;
  } else if k == 3 {
    m.x3 = v;
  } else if k == 4 {
    m.x4 = v;
  } else {
    m.x5 = v;
  }
  return m;
}

fn eps() -> f64 {
  return 0.00001f64;
}

fn mean(r : Row) -> f64 {
  return (r.x0 + r.x1 + r.x2 + r.x3 + r.x4 + r.x5) / 6.0f64;
}

// 1 / sqrt(var + eps), the factor LayerNorm divides by.
fn inv_sigma(r : Row) -> f64 {
  let m = mean(r);
  let mut v : f64 = 0.0;
  for k in 0..6 {
    let d = at(r, k) - m;
    v = v + d * d;
  }
  return 1.0f64 / (v / 6.0f64 + eps()).sqrt();
}

// Output k of LayerNorm (no gamma, beta).
fn layer_norm(r : Row, k : i32) -> f64 {
  return (at(r, k) - mean(r)) * inv_sigma(r);
}

fn rms_norm(r : Row, k : i32) -> f64 {
  let mut s : f64 = 0.0;
  for j in 0..6 {
    s = s + at(r, j) * at(r, j);
  }
  return at(r, k) / (s / 6.0f64 + eps()).sqrt();
}

// The upstream gradient g: fixed weights, so the loss is sum_k g_k y_k.
fn upstream(k : i32) -> f64 {
  return 0.3f64 * f64::from(k) - 0.7f64 + 0.1f64 * f64::from(k * k);
}

fn loss(r : Row) -> f64 {
  let mut l : f64 = 0.0;
  for k in 0..6 {
    l = l + upstream(k) * layer_norm(r, k);
  }
  return l;
}

// The loss with input k set to v: `grad` moves its first parameter.
fn loss_at(v : f64, r : Row, k : i32) -> f64 {
  return loss(with(r, k, v));
}

fn by_grad(r : Row, k : i32) -> f64 {
  return grad(loss_at, at(r, k), r, k);
}

// dL/dx_k from the formula: (g_k - mean(g) - y_k mean(g y)) / sigma.
fn by_formula(r : Row, k : i32) -> f64 {
  let mut mg : f64 = 0.0;
  let mut mgy : f64 = 0.0;
  for j in 0..6 {
    mg = mg + upstream(j);
    mgy = mgy + upstream(j) * layer_norm(r, j);
  }
  mg = mg / 6.0f64;
  mgy = mgy / 6.0f64;
  return (upstream(k) - mg - layer_norm(r, k) * mgy) * inv_sigma(r);
}

fn main() -> i32 {
  let mut failed = 0;
  let mut rng = Rng { s: 88172645463325252u64 };

  // 1. Rows of 4096 around 1000, spread 0.1 (variance about 0.0033).
  let mut worst_one : f64 = 0.0;
  let mut worst_two : f64 = 0.0;
  let mut worst_wel : f64 = 0.0;
  let mut negative = 0;
  let mut merged_err : f64 = 0.0;
  let mut mean_err : f64 = 0.0;
  for row in 0..20 {
    let mut x = Vec<f32>::with_capacity(4096);
    for i in 0..4096 {
      x.push((1000.0f64 + 0.2f64 * (rng.unit() - 0.5f64)) as f32);
    }
    let want = exact_variance(&x);
    let v1 = one_pass(&x);
    if v1 < 0.0f32 {
      negative = negative + 1;
    }
    worst_one = worst_one.max(rel(v1, want));
    worst_two = worst_two.max(rel(two_pass(&x), want));
    let w = welford(&x, 0, 4096);
    worst_wel = worst_wel.max(rel(w.m2 / w.n, want));
    // 2. Merge two uneven parts, the second shifted by 0.1 (as two shards of different data
    //    might be), so that the term for the difference of their means matters.
    let mut y = Vec<f32>::with_capacity(4096);
    for i in 0..4096 {
      if i < 1500 {
        y.push(x.get(i));
      } else {
        y.push(x.get(i) + 0.1f32);
      }
    }
    let m = merge(welford(&y, 0, 1500), welford(&y, 1500, 4096));
    merged_err = merged_err.max(rel(m.m2 / m.n, exact_variance(&y)));
    let mut sum : f64 = 0.0;
    for i in 0..4096 {
      sum = sum + f64::from(y.get(i));
    }
    mean_err = mean_err.max((f64::from(m.mean) - sum / 4096.0f64).abs());
  }
  print!("variance of 20 f32 rows of 4096 around 1000, spread 0.1, relative error:\n");
  print!("  one pass E[x^2] - E[x]^2: ");
  print!(worst_one);
  print!(" (");
  print!(negative);
  print!(" rows negative)\n  two passes: ");
  print!(worst_two);
  print!("\n  Welford: ");
  print!(worst_wel);
  print!("\n  Welford of two parts, merged: ");
  print!(merged_err);
  print!(", its mean off by ");
  print!(mean_err);
  print!("\n");
  if !(worst_one > 1.0f64) || !(worst_two < 0.01f64) || !(worst_wel < 0.01f64) {
    print!("FAIL: one pass should fail and the other two should not\n");
    failed = failed + 1;
  }
  // The running means carry f32 rounding into the merge's (mean difference)^2 term, so this
  // gets 5%; leaving that term out costs about 40%.
  if !(merged_err < 0.05f64) || !(mean_err < 0.005f64) {
    print!("FAIL: merging Welford statistics\n");
    failed = failed + 1;
  }

  // 3. RMSNorm equals LayerNorm on a row with mean zero.
  let z = Row { x0: 1.5f64, x1: -2.0f64, x2: 0.25f64, x3: 3.0f64, x4: -1.75f64, x5: -1.0f64 };
  let mut rms_diff : f64 = 0.0;
  for k in 0..6 {
    rms_diff = rms_diff.max((rms_norm(z, k) - layer_norm(z, k)).abs());
  }
  print!("RMSNorm vs LayerNorm on a row with mean 0: largest difference ");
  print!(rms_diff);
  print!("\n");
  if !(rms_diff < 0.000000000001f64) {
    print!("FAIL: RMSNorm and LayerNorm should agree when the mean is 0\n");
    failed = failed + 1;
  }

  // 4. The backward formula against `grad`, at a few rows.
  let mut grad_diff : f64 = 0.0;
  for t in 0..5 {
    let r = Row {
      x0: 4.0f64 * rng.unit() - 2.0f64,
      x1: 4.0f64 * rng.unit() - 2.0f64,
      x2: 4.0f64 * rng.unit() - 2.0f64,
      x3: 4.0f64 * rng.unit() - 2.0f64,
      x4: 4.0f64 * rng.unit() - 2.0f64,
      x5: 4.0f64 * rng.unit() - 2.0f64,
    };
    for k in 0..6 {
      let g = by_grad(r, k);
      grad_diff = grad_diff.max((g - by_formula(r, k)).abs());
    }
  }
  print!("LayerNorm backward, formula vs grad, 5 rows x 6 inputs: largest difference ");
  print!(grad_diff);
  print!("\n");
  if !(grad_diff < 0.000000000001f64) {
    print!("FAIL: LayerNorm's backward formula\n");
    failed = failed + 1;
  }

  if failed == 0 {
    print!("ok\n");
  }
  return failed;
}
