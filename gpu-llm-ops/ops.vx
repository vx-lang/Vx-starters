// gpu-llm-ops: the GPU kernels of a GPT-2 training step, after llm.c's CUDA code.
//
// Shapes are GPT-2 small where llm.c fixes them: 768 channels, 12 heads of 64. Every kernel is
// an `across` loop: `blocks` become CUDA blocks and `lanes` become threads. A comment says where
// the Vx form differs from llm.c.

import core::num;
import core::sync::atomic;

pub fn encoder_forward(out : &mut Tensor<f32, [?, ?, 768], Memory::HBM>, ix : &Tensor<i32, [?, ?], Memory::HBM>, wte : &Tensor<f32, [?, 768], Memory::HBM>, wpe : &Tensor<f32, [?, 768], Memory::HBM>, batch : i32, seq : i32) -> void {
  spawn on(Topology::Device) {
    for b in 0..batch across blocks {
      for t in 0..seq across blocks {
        for c in 0..768 across lanes(256) {
          out[b][t][c] = wte[ix[b][t]][c] + wpe[t][c];
        }
      }
    }
  }
  return;
}

pub fn encoder_backward_atomic(dwte : &Tensor<f32, [?], Memory::HBM>, dout : &Tensor<f32, [?, ?, 768], Memory::HBM>, ix : &Tensor<i32, [?, ?], Memory::HBM>, batch : i32, seq : i32) -> void {
  spawn on(Topology::Device) {
    for b in 0..batch across blocks {
      for t in 0..seq across blocks {
        for c in 0..768 across lanes(256) {
          let _old = atomic_fetch_add_f32(dwte, ix[b][t] * 768 + c, dout[b][t][c], AtomicOrdering::Relaxed);
        }
      }
    }
  }
  return;
}

pub fn gelu_forward(out : &mut Tensor<f32, [?], Memory::HBM>, inp : &Tensor<f32, [?], Memory::HBM>, n : i32) -> void {
  spawn on(Topology::Device) {
    for b in 0..(n + 255) / 256 across blocks {
      for l in 0..256 across lanes {
        let i = b * 256 + l;
        if i < n {
          let x = inp[i];
          let cube = 0.044715 * x * x * x;
          out[i] = 0.5 * x * (1.0 + (0.7978846 * (x + cube)).tanh());
        }
      }
    }
  }
  return;
}

pub fn gelu_backward(dinp : &mut Tensor<f32, [?], Memory::HBM>, inp : &Tensor<f32, [?], Memory::HBM>, dout : &Tensor<f32, [?], Memory::HBM>, n : i32) -> void {
  spawn on(Topology::Device) {
    for b in 0..(n + 255) / 256 across blocks {
      for l in 0..256 across lanes {
        let i = b * 256 + l;
        if i < n {
          let x = inp[i];
          let cube = 0.044715 * x * x * x;
          let th = (0.7978846 * (x + cube)).tanh();
          let sech2 = 1.0 - th * th;
          let local = 0.5 * (1.0 + th) + x * 0.5 * sech2 * 0.7978846 * (1.0 + 3.0 * 0.044715 * x * x);
          dinp[i] = dinp[i] + local * dout[i];
        }
      }
    }
  }
  return;
}

pub fn residual_forward(out : &mut Tensor<f32, [?], Memory::HBM>, a : &Tensor<f32, [?], Memory::HBM>, b2 : &Tensor<f32, [?], Memory::HBM>, n : i32) -> void {
  spawn on(Topology::Device) {
    for b in 0..(n + 255) / 256 across blocks {
      for l in 0..256 across lanes {
        let i = b * 256 + l;
        if i < n {
          out[i] = a[i] + b2[i];
        }
      }
    }
  }
  return;
}

pub fn matmul_forward(out : &mut Tensor<f32, [?, ?], Memory::HBM>, inp : &Tensor<f32, [?, ?], Memory::HBM>, weight : &Tensor<f32, [?, ?], Memory::HBM>, bias : &Tensor<f32, [?], Memory::HBM>, rows : i32, cols : i32, outs : i32) -> void {
  spawn on(Topology::Device) {
    for r in 0..rows across blocks {
      for o in 0..outs across lanes(256) {
        let mut s : f32 = bias[o];
        for c in 0..cols {
          s = s + inp[r][c] * weight[o][c];
        }
        out[r][o] = s;
      }
    }
  }
  return;
}

pub fn matmul_backward_bias_by_column(dbias : &mut Tensor<f32, [?], Memory::HBM>, dout : &Tensor<f32, [?, ?], Memory::HBM>, rows : i32, outs : i32) -> void {
  spawn on(Topology::Device) {
    for b in 0..(outs + 255) / 256 across blocks {
      for l in 0..256 across lanes {
        let o = b * 256 + l;
        if o < outs {
          let mut s : f32 = 0.0;
          for r in 0..rows {
            s = s + dout[r][o];
          }
          dbias[o] = dbias[o] + s;
        }
      }
    }
  }
  return;
}

pub fn matmul_backward_bias_atomic(dbias : &Tensor<f32, [?], Memory::HBM>, dout : &Tensor<f32, [?, ?], Memory::HBM>, rows : i32, outs : i32) -> void {
  spawn on(Topology::Device) {
    for r in 0..rows across blocks {
      for o in 0..outs across lanes(256) {
        let _old = atomic_fetch_add_f32(dbias, o, dout[r][o], AtomicOrdering::Relaxed);
      }
    }
  }
  return;
}

pub fn attention_permute(q : &mut Tensor<f32, [?, 12, ?, 64], Memory::HBM>, k : &mut Tensor<f32, [?, 12, ?, 64], Memory::HBM>, v : &mut Tensor<f32, [?, 12, ?, 64], Memory::HBM>, qkv : &Tensor<f32, [?, ?, 3, 12, 64], Memory::HBM>, batch : i32, seq : i32) -> void {
  spawn on(Topology::Device) {
    for b in 0..batch across blocks {
      for n in 0..seq across blocks {
        for h in 0..12 across lanes {
          for d in 0..64 across lanes {
            q[b][h][n][d] = qkv[b][n][0][h][d];
            k[b][h][n][d] = qkv[b][n][1][h][d];
            v[b][h][n][d] = qkv[b][n][2][h][d];
          }
        }
      }
    }
  }
  return;
}

pub fn attention_unpermute(out : &mut Tensor<f32, [?, ?, 12, 64], Memory::HBM>, inp : &Tensor<f32, [?, 12, ?, 64], Memory::HBM>, batch : i32, seq : i32) -> void {
  spawn on(Topology::Device) {
    for b in 0..batch across blocks {
      for n in 0..seq across blocks {
        for h in 0..12 across lanes {
          for d in 0..64 across lanes {
            out[b][n][h][d] = inp[b][h][n][d];
          }
        }
      }
    }
  }
  return;
}

pub fn attention_softmax_causal(att : &mut Tensor<f32, [?, ?, ?], Memory::HBM>, preatt : &Tensor<f32, [?, ?, ?], Memory::HBM>, heads : i32, seq : i32, scale : f32) -> void {
  spawn on(Topology::Device) {
    for h in 0..heads across blocks {
      for t in 0..seq across blocks {
        let mut part = unsafe { Tensor<f32, [128], Memory::SMEM>::uninit() };
        let mut stat = unsafe { Tensor<f32, [2], Memory::SMEM>::uninit() };
        for l in 0..128 across lanes {
          let mut m : f32 = -1000000000.0;
          let mut c = l;
          while c <= t {
            m = m.max(preatt[h][t][c] * scale);
            c = c + 128;
          }
          part[l] = m;
        }
        let mut m : f32 = part[0];
        for k in 1..128 {
          m = m.max(part[k]);
        }
        stat[0] = m;
        for l in 0..128 across lanes {
          let mut s : f32 = 0.0;
          let mut c = l;
          while c <= t {
            s = s + (preatt[h][t][c] * scale - stat[0]).exp();
            c = c + 128;
          }
          part[l] = s;
        }
        let mut s : f32 = 0.0;
        for k in 0..128 {
          s = s + part[k];
        }
        stat[1] = 1.0 / s;
        for c in 0..seq across lanes(128) {
          let mut a : f32 = 0.0;
          if c <= t {
            a = (preatt[h][t][c] * scale - stat[0]).exp() * stat[1];
          }
          att[h][t][c] = a;
        }
      }
    }
  }
  return;
}

pub fn crossentropy_forward(losses : &mut Tensor<f32, [?, ?], Memory::HBM>, probs : &Tensor<f32, [?, ?, ?], Memory::HBM>, targets : &Tensor<i32, [?, ?], Memory::HBM>, batch : i32, seq : i32) -> void {
  spawn on(Topology::Device) {
    for b in 0..batch across blocks {
      for t in 0..seq across lanes(128) {
        losses[b][t] = 0.0 - probs[b][t][targets[b][t]].ln();
      }
    }
  }
  return;
}

pub fn crossentropy_softmax_backward(dlogits : &mut Tensor<f32, [?, ?, ?], Memory::HBM>, dloss : &Tensor<f32, [?, ?], Memory::HBM>, probs : &Tensor<f32, [?, ?, ?], Memory::HBM>, targets : &Tensor<i32, [?, ?], Memory::HBM>, batch : i32, seq : i32, vocab : i32) -> void {
  spawn on(Topology::Device) {
    for b in 0..batch across blocks {
      for t in 0..seq across blocks {
        for v in 0..vocab across lanes(256) {
          let mut indicator : f32 = 0.0;
          if v == targets[b][t] {
            indicator = 1.0;
          }
          dlogits[b][t][v] = dlogits[b][t][v] + (probs[b][t][v] - indicator) * dloss[b][t];
        }
      }
    }
  }
  return;
}

pub fn adamw(params : &mut Tensor<f32, [?], Memory::HBM>, grads : &Tensor<f32, [?], Memory::HBM>, m : &mut Tensor<f32, [?], Memory::HBM>, v : &mut Tensor<f32, [?], Memory::HBM>, n : i32, lr : f32, beta1 : f32, beta2 : f32, correction1 : f32, correction2 : f32, eps : f32, decay : f32) -> void {
  spawn on(Topology::Device) {
    for b in 0..(n + 255) / 256 across blocks {
      for l in 0..256 across lanes {
        let i = b * 256 + l;
        if i < n {
          let g = grads[i];
          let mi = beta1 * m[i] + (1.0 - beta1) * g;
          let vi = beta2 * v[i] + (1.0 - beta2) * g * g;
          m[i] = mi;
          v[i] = vi;
          let mhat = mi / correction1;
          let vhat = vi / correction2;
          params[i] = params[i] - lr * (mhat / (vhat.sqrt() + eps) + decay * params[i]);
        }
      }
    }
  }
  return;
}

