// Tests for gpu-quant-ops: every kernel in ops.vx against the same formula as plain host code.
// Returns the number of failed checks, and prints "ok" when there are none. It also prints three
// entries of each result, which check.py computes again in Python.
//
//   ./build.sh

import core::convert;
import core::num;
import ops;

// Inputs: whole numbers scaled by 1/8, so every value is exact in f32 and Python sees the same.
macro_rules x { ($i : expr) => { (((($i) * 37) % 101) as f32) / 8.0 - 6.0 }; }

fn abs64(v : f64) -> f64 {
  if v < 0.0 {
    return 0.0 - v;
  }
  return v;
}

fn verdict(name : *const i8, worst : f64, tol : f64, e0 : f32, e1 : f32, e2 : f32) -> i32 {
  print!(name);
  print!(": ");
  print!(f64::from(e0));
  print!(" ");
  print!(f64::from(e1));
  print!(" ");
  print!(f64::from(e2));
  print!("\n");
  if worst > tol {
    print!("  FAIL: differs from the host code by ");
    print!(worst);
    print!("\n");
    return 1;
  }
  return 0;
}

const ROWS : i32 = 40;
const COLS : i32 = 320;
const BATCH : i32 = 3;

// Host decoders, written apart from the kernels' macros.
fn bf16_host(bits : u32) -> f32 {
  return libm_f32_from_bits(bits << 16u32);
}

fn fp8_host(b : i32) -> f32 {
  let e = (b >> 3) & 15;
  let m = b & 7;
  let mut v : f32 = (m as f32) / 512.0;
  if e > 0 {
    v = (8 + m) as f32;
    if e >= 10 {
      v = v * ((1 << (e - 10)) as f32);
    } else {
      v = v / ((1 << (10 - e)) as f32);
    }
  }
  if b >= 128 { v = 0.0 - v; }
  return v;
}

// The activations: one vector for the matvec, BATCH rows for the matmul.
fn make_xv() -> Tensor<f32, [320]> {
  let mut xv = Tensor<f32, [320]>::new();
  for c in 0..COLS { xv[c] = x!(c) / 4.0; }
  return xv;
}

fn make_xm() -> Tensor<f32, [3, 320]> {
  let mut xm = Tensor<f32, [3, 320]>::new();
  for m in 0..BATCH {
    for c in 0..COLS { xm[m][c] = x!(m * COLS + c) / 4.0; }
  }
  return xm;
}

// What a kernel computes, in its order: each of 256 lanes sums its strided columns, then the
// lanes' parts are added. `post` is a scale for each row, applied after the sum.
fn ref_row(wf : &Tensor<f32, [40, 320]>, r : i32, xr : &Tensor<f32, [320]>, post : f32) -> f32 {
  let mut total : f32 = 0.0;
  for l in 0..256 {
    let mut s : f32 = 0.0;
    let mut c = l;
    while c < COLS {
      s += wf[r][c] * xr[c];
      c += 256;
    }
    total += s;
  }
  return total * post;
}

// Compares both kernels of a format with the reference over every output. `wf` holds the
// decoded weights (with a group's scale in them when the format has one), `post` each row's
// scale to apply after the sum.
fn compare(name : *const i8, wf : &Tensor<f32, [40, 320]>, post : &Tensor<f32, [40]>, y : &Tensor<f32, [?]>, out : &Tensor<f32, [?, ?]>) -> i32 {
  let mut failed = 0;
  let xv = make_xv();
  let xm = make_xm();
  let mut worst_y : f64 = 0.0;
  for r in 0..ROWS {
    let want = ref_row(wf, r, &xv, post[r]);
    let d = abs64(f64::from(y[r] - want)) / (1.0 + abs64(f64::from(want)));
    if d > worst_y { worst_y = d; }
  }
  let mut worst_o : f64 = 0.0;
  let mut xr = Tensor<f32, [320]>::new();
  for m in 0..BATCH {
    for c in 0..COLS { xr[c] = xm[m][c]; }
    for r in 0..ROWS {
      let want = ref_row(wf, r, &xr, post[r]);
      let d = abs64(f64::from(out[m][r] - want)) / (1.0 + abs64(f64::from(want)));
      if d > worst_o { worst_o = d; }
    }
  }
  print!(name);
  failed += verdict("_matvec", worst_y, 0.00001, y[0], y[19], y[39]);
  print!(name);
  failed += verdict("_matmul", worst_o, 0.00001, out[0][0], out[1][19], out[2][39]);
  return failed;
}

fn ones() -> Tensor<f32, [40]> {
  let mut p = Tensor<f32, [40]>::new();
  for r in 0..ROWS { p[r] = 1.0; }
  return p;
}

fn test_bf16() -> i32 {
  let mut w_h = Tensor<u16, [40, 320]>::new();
  let mut wf = Tensor<f32, [40, 320]>::new();
  for r in 0..ROWS {
    for c in 0..COLS {
      let e = 120 + (r * 7 + c * 3) % 11;
      let m = (r * 13 + c * 5) % 128;
      let s = (r + c) % 2;
      let bits = s * 32768 + e * 128 + m;
      w_h[r][c] = bits as u16;
      wf[r][c] = bf16_host(bits as u32);
    }
  }
  let w = transfer(w_h, Memory::HBM);
  let xv = transfer(make_xv(), Memory::HBM);
  let xm = transfer(make_xm(), Memory::HBM);
  let mut y = transfer(Tensor<f32, [40]>::new(), Memory::HBM);
  let mut out = transfer(Tensor<f32, [3, 40]>::new(), Memory::HBM);
  bf16_matvec(&mut y, &w, &xv, ROWS, COLS);
  bf16_matmul(&mut out, &w, &xm, BATCH, ROWS, COLS);
  let y_o = transfer(y, Memory::CPU_DRAM);
  let out_o = transfer(out, Memory::CPU_DRAM);
  return compare("bf16", &wf, &ones(), &y_o, &out_o);
}

// A scale for each row: 1/16 to 5/16.
fn make_scale() -> Tensor<f32, [40]> {
  let mut sc = Tensor<f32, [40]>::new();
  for r in 0..ROWS { sc[r] = ((1 + r % 5) as f32) / 16.0; }
  return sc;
}

fn test_fp8() -> i32 {
  let mut w_h = Tensor<u8, [40, 320]>::new();
  let mut wf = Tensor<f32, [40, 320]>::new();
  for r in 0..ROWS {
    for c in 0..COLS {
      // Exponents 3 to 10, and a subnormal at every 17th column. Never the NaN (0x7f, 0xff).
      let mut e = 3 + (r * 5 + c * 7) % 8;
      if c % 17 == 0 { e = 0; }
      let b = ((r + c) % 2) * 128 + e * 8 + (r * 3 + c) % 8;
      w_h[r][c] = b as u8;
      wf[r][c] = fp8_host(b);
    }
  }
  let w = transfer(w_h, Memory::HBM);
  let sc = transfer(make_scale(), Memory::HBM);
  let xv = transfer(make_xv(), Memory::HBM);
  let xm = transfer(make_xm(), Memory::HBM);
  let mut y = transfer(Tensor<f32, [40]>::new(), Memory::HBM);
  let mut out = transfer(Tensor<f32, [3, 40]>::new(), Memory::HBM);
  fp8_matvec(&mut y, &w, &sc, &xv, ROWS, COLS);
  fp8_matmul(&mut out, &w, &sc, &xm, BATCH, ROWS, COLS);
  let y_o = transfer(y, Memory::CPU_DRAM);
  let out_o = transfer(out, Memory::CPU_DRAM);
  return compare("fp8", &wf, &make_scale(), &y_o, &out_o);
}

fn test_int8() -> i32 {
  let mut w_h = Tensor<i8, [40, 320]>::new();
  let mut wf = Tensor<f32, [40, 320]>::new();
  for r in 0..ROWS {
    for c in 0..COLS {
      let q = (r * 31 + c * 17) % 255 - 127;
      w_h[r][c] = q as i8;
      wf[r][c] = q as f32;
    }
  }
  let w = transfer(w_h, Memory::HBM);
  let sc = transfer(make_scale(), Memory::HBM);
  let xv = transfer(make_xv(), Memory::HBM);
  let xm = transfer(make_xm(), Memory::HBM);
  let mut y = transfer(Tensor<f32, [40]>::new(), Memory::HBM);
  let mut out = transfer(Tensor<f32, [3, 40]>::new(), Memory::HBM);
  int8_matvec(&mut y, &w, &sc, &xv, ROWS, COLS);
  int8_matmul(&mut out, &w, &sc, &xm, BATCH, ROWS, COLS);
  let y_o = transfer(y, Memory::CPU_DRAM);
  let out_o = transfer(out, Memory::CPU_DRAM);
  return compare("int8", &wf, &make_scale(), &y_o, &out_o);
}

// int4: a code 0..15 for each weight (8..15 stand for -8..-1), two to a byte, and a scale for
// each group of 64 columns. The scale is inside `wf`, so the rows' scales after the sum are 1.
fn test_int4() -> i32 {
  let mut w_h = Tensor<u8, [40, 160]>::new();
  let mut g_h = Tensor<f32, [40, 5]>::new();
  let mut wf = Tensor<f32, [40, 320]>::new();
  for r in 0..ROWS {
    for g in 0..5 { g_h[r][g] = ((1 + (r + g) % 3) as f32) / 16.0; }
    for j in 0..160 {
      let lo = (r * 3 + (2 * j) * 5) % 16;
      let hi = (r * 3 + (2 * j + 1) * 5) % 16;
      w_h[r][j] = (lo + hi * 16) as u8;
      let mut vlo = lo;
      if vlo >= 8 { vlo = vlo - 16; }
      let mut vhi = hi;
      if vhi >= 8 { vhi = vhi - 16; }
      wf[r][2 * j] = (vlo as f32) * g_h[r][(2 * j) / 64];
      wf[r][2 * j + 1] = (vhi as f32) * g_h[r][(2 * j + 1) / 64];
    }
  }
  let w = transfer(w_h, Memory::HBM);
  let g = transfer(g_h, Memory::HBM);
  let xv = transfer(make_xv(), Memory::HBM);
  let xm = transfer(make_xm(), Memory::HBM);
  let mut y = transfer(Tensor<f32, [40]>::new(), Memory::HBM);
  let mut out = transfer(Tensor<f32, [3, 40]>::new(), Memory::HBM);
  int4_matvec(&mut y, &w, &g, &xv, ROWS, COLS);
  int4_matmul(&mut out, &w, &g, &xm, BATCH, ROWS, COLS);
  let y_o = transfer(y, Memory::CPU_DRAM);
  let out_o = transfer(out, Memory::CPU_DRAM);
  return compare("int4", &wf, &ones(), &y_o, &out_o);
}

fn main() -> i32 {
  let mut failed = 0;
  failed += test_bf16();
  failed += test_fp8();
  failed += test_int8();
  failed += test_int4();
  if failed == 0 {
    print!("ok\n");
  }
  return failed;
}
