// Tests for rational. Prints some fractions for build.sh to compare, then "ok", and returns
// the number of failed checks.
//
//   ./build.sh

import bigint::int;
import rational::rat;

fn q(s : *const i8) -> Rational {
  return Rational::parse(s).unwrap();
}

fn check(name : *const i8, ok : bool) -> i32 {
  if ok {
    return 0;
  }
  print!("FAIL: ");
  print!(name);
  print!("\n");
  return 1;
}

fn check_eq(name : *const i8, got : &Rational, want : &Rational) -> i32 {
  if got.compare(want) == 0 {
    return 0;
  }
  print!("FAIL: ");
  print!(name);
  print!(": got ");
  got.print();
  print!(", want ");
  want.print();
  print!("\n");
  return 1;
}

// In lowest terms, with a positive denominator.
fn normal(x : &Rational) -> bool {
  return x.den.sign() > 0 && x.num.gcd(&x.den).compare(&BigInt::from_i64(1)) == 0;
}

// xorshift64, as in ../bigint/test.vx.
struct Rng {
  s : u64,
}

impl Rng {
  fn next(self : &mut Rng) -> u64 {
    let mut x = self.s;
    x = x ^ (x << 13);
    x = x ^ (x >> 7);
    x = x ^ (x << 17);
    self.s = x;
    return x;
  }

  // A fraction with numerator and denominator of up to about 40 bits.
  fn frac(self : &mut Rng) -> Rational {
    let n = (self.next() % 2199023255552u64) as i64 - 1099511627776;
    let d = (self.next() % 1099511627776u64) as i64 + 1;
    return Rational::frac(n, d);
  }
}

fn check_three(a : &Rational, b : &Rational, c : &Rational, k : i64) -> i32 {
  let mut failed = 0;
  let one = Rational::from_i64(1);
  failed += check("a + b is normal", normal(&a.plus(b)));
  failed += check("a * b is normal", normal(&a.times(b)));
  failed += check_eq("a + b - b", &a.plus(b).minus(b), a);
  failed += check_eq("a * (b + c)", &a.times(&b.plus(c)), &a.times(b).plus(&a.times(c)));
  if !b.is_zero() {
    failed += check_eq("a * b / b", &a.times(b).over(b), a);
    failed += check("a / b is normal", normal(&a.over(b)));
    failed += check_eq("b * (1 / b)", &b.times(&b.recip()), &one);
  }
  failed += check("a < b iff b - a > 0", (a.compare(b) < 0) == (b.minus(a).sign() > 0));

  let f = Rational::from_int(a.floor());
  let c1 = Rational::from_int(a.ceil());
  failed += check("floor <= a < floor + 1", f.compare(a) <= 0 && a.compare(&f.plus(&one)) < 0);
  failed += check("ceil - 1 < a <= ceil", c1.minus(&one).compare(a) < 0 && a.compare(&c1) <= 0);

  let lo = a.floor_bits(k);
  let hi = a.ceil_bits(k);
  let step = Rational::frac(1, 1).over(&Rational::from_int(BigInt::from_i64(1).shl(k)));
  failed += check("floor_bits <= a <= ceil_bits", lo.compare(a) <= 0 && a.compare(&hi) <= 0);
  failed += check("ceil_bits - floor_bits <= 2^-k", hi.minus(&lo).compare(&step) <= 0);
  return failed;
}

fn main() -> i32 {
  let mut failed = 0;

  failed += check_eq("1/2 + 1/3", &q("1/2").plus(&q("1/3")), &q("5/6"));
  failed += check_eq("-6/4", &q("-6/4"), &Rational::frac(-3, 2));
  failed += check_eq("6/-4", &Rational::frac(6, -4), &Rational::frac(-3, 2));
  failed += check("-6/4 is normal", normal(&q("-6/4")));
  failed += check("6/-4 is normal", normal(&Rational::frac(6, -4)));
  failed += check("1 / (-2/3) is normal", normal(&Rational::from_i64(1).over(&q("-2/3"))));
  failed += check("(-2/3)^-3 is normal", normal(&q("-2/3").pow(-3)));
  failed += check_eq("(-3/2)^5", &q("-3/2").pow(5), &q("-243/32"));
  failed += check_eq("(2/3)^-2", &q("2/3").pow(-2), &q("9/4"));
  failed += check("floor(-7/2) = -4", q("-7/2").floor().compare(&BigInt::from_i64(-4)) == 0);
  failed += check("ceil(-7/2) = -3", q("-7/2").ceil().compare(&BigInt::from_i64(-3)) == 0);
  failed += check("floor(7/2) = 3", q("7/2").floor().compare(&BigInt::from_i64(3)) == 0);
  failed += check_eq("floor_bits(1/3, 4)", &q("1/3").floor_bits(4), &q("5/16"));
  failed += check_eq("ceil_bits(1/3, 4)", &q("1/3").ceil_bits(4), &q("3/8"));
  failed += check_eq("ceil_bits(-1/3, 4)", &q("-1/3").ceil_bits(4), &q("-5/16"));
  failed += check("-1/3 < -1/4", q("-1/3").compare(&q("-1/4")) < 0);
  failed += check("parse rejects 1/0", Rational::parse("1/0").is_none());
  failed += check("parse rejects 1/", Rational::parse("1/").is_none());
  failed += check("parse rejects /2", Rational::parse("/2").is_none());
  failed += check("parse rejects 1/2/3", Rational::parse("1/2/3").is_none());
  let third = q("1/3").to_f64();
  failed += check("to_f64(1/3)", third > 0.33333333333333 && third < 0.33333333333334);

  // The harmonic number H_20.
  let mut h = Rational::zero();
  for i in 1..21 {
    h = h.plus(&Rational::frac(1, i as i64));
  }
  failed += check_eq("H_20", &h, &q("55835135/15519504"));

  let mut rng = Rng { s: 2463534242u64 };
  for i in 0..2000 {
    let a = rng.frac();
    let b = rng.frac();
    let c = rng.frac();
    failed += check_three(&a, &b, &c, (rng.next() % 80u64) as i64);
  }

  // build.sh compares these with Python's fractions.Fraction.
  h.print();
  print!("\n");
  q("-3/2").pow(5).print();
  print!("\n");
  q("123456789012345678901234567890/-987654321").print();
  print!("\n");

  if failed == 0 {
    print!("ok\n");
  }
  return failed;
}
