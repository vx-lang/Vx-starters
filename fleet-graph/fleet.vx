// fleet-graph, fleet: a data center as a graph. The vertices are the domains (a node or a rack on
// its own NVLink fabric), one leaf switch for each group of domains, and one spine. A domain
// reaches its leaf at `gpus * nic` bytes/s; a leaf reaches the spine at the sum of its domains'
// uplinks divided by the oversubscription. Domains on one leaf talk at full rate, domains on
// different leaves through the spine, at the narrower of the leaf links.
//
// What a placement asks of a fleet is the bandwidth a group of domains gets between them, and the
// latency, both read off the graph (widest path, least latency).

import core::convert;
import core::num;
import graph;
import hw;
import std::vec;

struct Fleet {
  doms : Vec<Domain>,
  leaf : Vec<i32>,
  leaves : i32,
  wide : Vec<f64>,       // widest path between any two vertices
  late : Vec<f64>,       // least latency between any two vertices
  nv : i32,
  cls : Vec<i32>,        // the first domain of the same class (same SKU and size): a class number
  ngpu : Vec<i32>,       // GPUs of each domain
}

fn fl(x : i32) -> f64 {
  return f64::from(x);
}

pub fn new_fleet() -> Fleet {
  return Fleet { doms: Vec<Domain>::with_capacity(8), leaf: Vec<i32>::with_capacity(8), leaves: 0, wide: Vec<f64>::with_capacity(1), late: Vec<f64>::with_capacity(1), nv: 0, cls: Vec<i32>::with_capacity(8), ngpu: Vec<i32>::with_capacity(8) };
}

// Adds a domain under leaf switch `leaf` (numbered from 0). Call `wire` when all are added.
pub fn add_domain(f : &mut Fleet, d : Domain, leaf : i32) -> void {
  f.doms.push(d);
  f.leaf.push(leaf);
  if leaf + 1 > f.leaves {
    f.leaves = leaf + 1;
  }
  return;
}

pub fn count(f : &Fleet) -> i32 {
  return f.doms.len();
}

fn micro() -> f64 {
  return 0.000001f64;
}

// Builds the graph and its path tables. Vertex i is domain i, vertex n + l is leaf l, vertex
// n + leaves is the spine.
pub fn wire(f : &mut Fleet, oversub : f64) -> void {
  let n = f.doms.len();
  let spine = n + f.leaves;
  f.nv = spine + 1;
  let mut g = new_graph(f.nv);
  let mut under = Vec<f64>::with_capacity(f.leaves);
  for l in 0..f.leaves {
    under.push(0.0f64);
  }
  for i in 0..n {
    let up = uplink(f.doms.get(i));
    add_edge(&mut g, i, n + f.leaf.get(i), up, micro());
    under.set(f.leaf.get(i), under.get(f.leaf.get(i)) + up);
  }
  for l in 0..f.leaves {
    add_edge(&mut g, n + l, spine, under.get(l) / oversub, 2.0f64 * micro());
  }
  f.wide = widest(&g);
  f.late = fastest(&g);
  // The class of each domain, and its size, as numbers: comparing two domains' structs for every
  // pair is where a placement search would spend its time.
  f.cls = Vec<i32>::with_capacity(n);
  f.ngpu = Vec<i32>::with_capacity(n);
  for i in 0..n {
    let mut c = i;
    for j in 0..i {
      if c == i && same_class(f.doms.get(j), f.doms.get(i)) {
        c = f.cls.get(j);
      }
    }
    f.cls.push(c);
    f.ngpu.push(f.doms.get(i).gpus);
  }
  return;
}

pub fn domain(f : &Fleet, i : i32) -> Domain {
  return f.doms.get(i);
}

// A class of domains: the same SKU and size.
pub fn same_class(a : Domain, b : Domain) -> bool {
  return a.gpus == b.gpus && a.sku.cost == b.sku.cost && a.sku.hbm == b.sku.hbm;
}

// Bytes/s per GPU between the domains `members`, when all of them send to all the others at
// once: the narrowest pair, where the leaf link of a pair on different leaves is shared by the
// members under that leaf. 0 for a single domain.
pub fn group_bandwidth(f : &Fleet, members : &Vec<i32>) -> f64 {
  let n = f.doms.len();
  let m = members.len();
  let mut best = 1000000000000000.0f64;
  for x in 0..m {
    let a = members.get(x);
    let mut share = 0;
    for y in 0..m {
      if f.leaf.get(members.get(y)) == f.leaf.get(a) {
        share += 1;
      }
    }
    for y in 0..m {
      let b = members.get(y);
      if a != b {
        let mut bw = f.wide.get(a * f.nv + b);
        if f.leaf.get(a) != f.leaf.get(b) {
          // The leaf's link to the spine is shared by the members on that leaf.
          let leaf_up = f.wide.get((n + f.leaf.get(a)) * f.nv + (n + f.leaves));
          bw = bw.min(leaf_up / fl(share));
        }
        let per_gpu = bw / fl(f.ngpu.get(a));
        if per_gpu < best {
          best = per_gpu;
        }
      }
    }
  }
  if m < 2 {
    return 0.0f64;
  }
  return best;
}

// The same as `group_bandwidth` for domains of one class, in time for the leaves instead of the
// pairs: two members on one leaf are alike, so it looks at one member of each leaf and, where a
// leaf has two or more, one pair inside it.
pub fn group_bandwidth_of_class(f : &Fleet, members : &Vec<i32>) -> f64 {
  let m = members.len();
  if m < 2 {
    return 0.0f64;
  }
  let n = f.doms.len();
  let mut cnt = Vec<i32>::with_capacity(f.leaves);
  let mut first = Vec<i32>::with_capacity(f.leaves);
  let mut second = Vec<i32>::with_capacity(f.leaves);
  for l in 0..f.leaves {
    cnt.push(0);
    first.push(0 - 1);
    second.push(0 - 1);
  }
  for x in 0..m {
    let a = members.get(x);
    let l = f.leaf.get(a);
    if cnt.get(l) == 0 {
      first.set(l, a);
    }
    if cnt.get(l) == 1 {
      second.set(l, a);
    }
    cnt.set(l, cnt.get(l) + 1);
  }
  let mut best = 1000000000000000.0f64;
  for la in 0..f.leaves {
    if cnt.get(la) > 0 {
      let a = first.get(la);
      if cnt.get(la) >= 2 {
        let per_gpu = f.wide.get(a * f.nv + second.get(la)) / fl(f.ngpu.get(a));
        if per_gpu < best {
          best = per_gpu;
        }
      }
      let leaf_up = f.wide.get((n + la) * f.nv + (n + f.leaves)) / fl(cnt.get(la));
      for lb in 0..f.leaves {
        if lb != la && cnt.get(lb) > 0 {
          let bw = f.wide.get(a * f.nv + first.get(lb)).min(leaf_up);
          let per_gpu = bw / fl(f.ngpu.get(a));
          if per_gpu < best {
            best = per_gpu;
          }
        }
      }
    }
  }
  return best;
}

// The largest one-way latency between two of `members`, seconds; 0 for a single domain.
pub fn group_latency(f : &Fleet, members : &Vec<i32>) -> f64 {
  let m = members.len();
  let mut worst = 0.0f64;
  for x in 0..m {
    for y in 0..m {
      let t = f.late.get(members.get(x) * f.nv + members.get(y));
      if t > worst {
        worst = t;
      }
    }
  }
  return worst;
}

// The free domains of the class of `proto` that are not in `group`, one for each leaf (the lowest
// number): two such domains on one leaf sit in the same place in the graph, so trying one of them
// is trying both.
pub fn representatives(f : &Fleet, free : &Vec<i32>, class : i32, group : &Vec<i32>) -> Vec<i32> {
  let n = f.doms.len();
  let mut out = Vec<i32>::with_capacity(f.leaves);
  let mut seen = Vec<i32>::with_capacity(f.leaves);
  for l in 0..f.leaves {
    seen.push(0);
  }
  for c in 0..n {
    if free.get(c) == 1 && f.cls.get(c) == class && seen.get(f.leaf.get(c)) == 0 {
      let mut taken = false;
      for k in 0..group.len() {
        if group.get(k) == c {
          taken = true;
        }
      }
      if !taken {
        out.push(c);
        seen.set(f.leaf.get(c), 1);
      }
    }
  }
  return out;
}

// Chooses `want` free domains of the same class as domain `class_of`, as close together as the
// graph allows: for each start (a free domain of the class, one for each leaf) add the free
// domain (again one for each leaf) that keeps the group's bandwidth highest (ties to the lower
// number), and keep the start that ends best (ties to the lower number). `free[i]` is 1 for a free
// domain. Returns fewer than `want` if the fleet has not that many.
pub fn pick_group(f : &Fleet, class_of : i32, want : i32, free : &Vec<i32>) -> Vec<i32> {
  let class = f.cls.get(class_of);
  let mut best = Vec<i32>::with_capacity(want);
  let mut best_bw = -1.0f64;
  let none = Vec<i32>::with_capacity(1);
  let seeds = representatives(f, free, class, &none);
  for si in 0..seeds.len() {
    let mut group = Vec<i32>::with_capacity(want);
    group.push(seeds.get(si));
    while group.len() < want {
      let cands = representatives(f, free, class, &group);
      let mut pick = -1;
      let mut pick_bw = -1.0f64;
      for ci in 0..cands.len() {
        group.push(cands.get(ci));
        let bw = group_bandwidth_of_class(f, &group);
        group.pop();
        if bw > pick_bw {
          pick_bw = bw;
          pick = cands.get(ci);
        }
      }
      if pick < 0 {
        break;
      }
      group.push(pick);
    }
    if group.len() == want {
      let bw = group_bandwidth_of_class(f, &group);
      if bw > best_bw {
        best_bw = bw;
        best = group;
      }
    }
  }
  return best;
}

// The least latency between two domains, seconds.
pub fn latency_between(f : &Fleet, a : i32, b : i32) -> f64 {
  return f.late.get(a * f.nv + b);
}

// The class number of domain i: domains of one SKU and size share it.
pub fn class_number(f : &Fleet, i : i32) -> i32 {
  return f.cls.get(i);
}
