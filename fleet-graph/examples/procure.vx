// What to buy: the cheapest fleet that carries a load. The same planner, run over a grid of fleets
// instead of one.
//
//   vxc -a run-jit examples/procure.vx
//
// The load is the one of examples/datacenter.vx without the million-token service. A fleet is a
// number of NVL72 racks, H200 nodes and A100-80 nodes; its price is the hourly cost of all its GPUs,
// used or not. For each fleet the services are placed (the one with the largest need first), and
// the fleet is met if nothing is left unmet. The table has one line for each fleet.

import core::convert;
import core::num;
import fleet;
import hw;
import model;
import plan;
import report;
import std::vec;

fn build(racks : i32, h200s : i32, a100s : i32) -> Fleet {
  let mut f = new_fleet();
  let mut leaf = 0;
  for i in 0..racks {
    add_domain(&mut f, nvl72(b200()), leaf);
    leaf += 1;
  }
  for i in 0..h200s {
    add_domain(&mut f, hgx8(h200()), leaf + i / 6);
  }
  leaf += (h200s + 5) / 6;
  for i in 0..a100s {
    add_domain(&mut f, hgx8(a100_80()), leaf + i / 8);
  }
  wire(&mut f, 2.0f64);
  return f;
}

fn price(racks : i32, h200s : i32, a100s : i32) -> f64 {
  return f64::from(racks) * 72.0f64 * b200().cost + f64::from(h200s) * 8.0f64 * h200().cost + f64::from(a100s) * 8.0f64 * a100_80().cost;
}

fn main() -> i32 {
  let mut svcs = Vec<Service>::with_capacity(4);
  svcs.push(with_mode(with_name(make_service(deepseek_v3(), 30.0f64, 8192, 512, 0.05f64, 2.0f64, 1.0f64, 1, 2048), "chat-ds"), 2));
  svcs.push(with_mode(with_name(make_service(glm_4_5(), 20.0f64, 4096, 512, 0.05f64, 2.0f64, 2.0f64, 0, 2048), "chat-glm"), 2));
  svcs.push(with_mode(with_name(make_service(deepseek_v3(), 2.0f64, 131072, 1024, 0.08f64, 60.0f64, 1.0f64, 1, 128), "docs-ds"), 2));
  svcs.push(with_mode(with_name(make_service(deepseek_v3(), 15.0f64, 32768, 256, 0.06f64, 10.0f64, 1.0f64, 1, 512), "agents-ds"), 2));

  print!("fleets (price in units an hour; unmet is the share of the load left, summed over the services)\n");
  let mut best_price = 1000000000.0f64;
  let mut best_racks = 0 - 1;
  let mut best_h = 0;
  let mut best_a = 0;
  for r in 0..3 {
    for hi in 0..3 {
      for ai in 0..3 {
        let racks = r;
        let h200s = hi * 6;
        let a100s = ai * 12;
        if racks + h200s + a100s > 0 {
          let f = build(racks, h200s, a100s);
          let order = demand_order(&f, &svcs);
          let p = schedule_in_order(&f, &svcs, &order);
          let sh = shortfall(&svcs, &p);
          print!("  ");
          print!(racks);
          print!(" racks, ");
          print!(h200s);
          print!(" H200 nodes, ");
          print!(a100s);
          print!(" A100 nodes: ");
          print_f(price(racks, h200s, a100s), 0);
          print!(", unmet ");
          print_f(sh, 2);
          print!("\n");
          if sh < 0.000000001f64 && price(racks, h200s, a100s) < best_price {
            best_price = price(racks, h200s, a100s);
            best_racks = racks;
            best_h = h200s;
            best_a = a100s;
          }
        }
      }
    }
  }
  if best_racks < 0 {
    print!("no fleet of the grid carries the load\n");
    return 0;
  }
  print!("cheapest that carries it: ");
  print!(best_racks);
  print!(" racks, ");
  print!(best_h);
  print!(" H200 nodes, ");
  print!(best_a);
  print!(" A100 nodes, ");
  print_f(best_price, 0);
  print!(" an hour\n");
  let f = build(best_racks, best_h, best_a);
  let plan = schedule(&f, &svcs);
  print_report(&f, &svcs, &plan);
  print_headroom(&f, &svcs);
  return 0;
}
